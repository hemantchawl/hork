# Needed only for `npm run load:menus` (menu extraction with Claude).
ANTHROPIC_API_KEY=

# Google sign-in (OAuth client of type "Web application").
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL of the app, e.g. https://hork.example.com (defaults to the request's origin).
APP_URL=
# Random string, 32+ characters, used to sign session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Handle-only sign-in (no password) for local testing. Defaults to on only when Google isn't configured.
HORK_ALLOW_HANDLE_LOGIN=
# Comma-separated handles or emails allowed to use /admin. Empty = any signed-in user.
HORK_ADMINS=
